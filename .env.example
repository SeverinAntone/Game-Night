# Required: signs and verifies session cookies. Generate one with:
#   openssl rand -hex 32
# Changing this logs everyone out. Losing it (e.g. a container recreated
# without persisting it) does the same — set it once via an environment
# variable in your deploy config, not a default in code.
AUTH_SECRET=

# Optional: IANA timezone used for grouping and displaying game-night dates
# (e.g. the History tab). Defaults to America/Los_Angeles. Every date in the
# app is shown in this one timezone regardless of the server's own or any
# individual viewer's — a game night is a shared household event, not a
# per-viewer one.
APP_TIMEZONE=America/Los_Angeles

# Optional: BoardGameGeek XML API token.
#
# BGG closed the XML API to anonymous callers, so the "BGG" button in the New
# Game wizard needs a token to work. Register at
# https://boardgamegeek.com/using_the_xml_api and paste the token here, in a
# file named .env.local (copy this file), then restart the server.
#
# Everything else in the app works fine without it — BGG only fills in box art,
# player count, year and weight as defaults.
BGG_TOKEN=
